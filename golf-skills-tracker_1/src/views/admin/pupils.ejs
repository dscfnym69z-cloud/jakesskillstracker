<section>
  <h1>Pupils</h1>
  <% if (typeof error !== 'undefined' && error) { %><p class="error"><%= error %></p><% } %>

  <div class="card narrow">
    <h2>Add a pupil</h2>
    <form method="post" action="/admin/pupils" class="stack-form">
      <label>Name
        <input type="text" name="name" required />
      </label>
      <button class="btn btn-primary" type="submit">Add pupil</button>
    </form>
  </div>

  <div class="card">
    <h2>All pupils (<%= pupils.length %>)</h2>
    <% if (!pupils.length) { %>
      <p class="muted">No pupils yet — add one above.</p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Name</th><th>Added</th><th></th></tr></thead>
        <tbody>
          <% pupils.forEach(function(p) { %>
            <tr>
              <td>
                <form method="post" action="/admin/pupils/<%= p.id %>/edit" class="inline-form">
                  <input type="text" name="name" value="<%= p.name %>" />
                  <button class="btn btn-small" type="submit">Save</button>
                </form>
              </td>
              <td><%= new Date(p.created_at).toLocaleDateString('en-GB') %></td>
              <td>
                <form method="post" action="/admin/pupils/<%= p.id %>/delete" class="inline-form" onsubmit="return confirm('Remove ' + <%- JSON.stringify(p.name) %> + ' and all their scores?');">
                  <button class="btn btn-danger btn-small" type="submit">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    <% } %>
  </div>
</section>
